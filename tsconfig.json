{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/store/*": [
        "app/(store)/*"
      ],
      "@/domain/*": [
        "app/(domain)/*"
      ],
      "@/app/*": [
        "app/*"
      ],
      "@/util/*": [
        "util/*"
      ],
      "@/components/*": [
        "components/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "target": "es2020",
    "lib": [
      "DOM",
      "DOM.iterable",
      "es2021"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app",
    "src",
    "pages",
    "components",
    "proxy.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}

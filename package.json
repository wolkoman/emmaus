    "build": "next build",
    "dev": "node scripts/dev.mjs",
    "generate": "cockpit-client generate --output=./util/cockpit.generated.ts",
    "email": "email dev",
    "pb:local": "docker compose -f pb/docker-compose.yml up -d",
    "pb:local:down": "docker compose -f pb/docker-compose.yml down",
    "pb:local:logs": "docker compose -f pb/docker-compose.yml logs -f",
    "pb:local:reset": "docker compose -f pb/docker-compose.yml down -v && rm -rf pb/pb_data && docker compose -f pb/docker-compose.yml up -d",
    "pb:local:ui": "open http://localhost:8090/_/",
    "pb:types": "pocketbase-typegen --url http://localhost:8090 --email admin@emmaus.local --password devpassword --out pb/pocketbase-types.ts",
    "pb:seed": "tsx pb/seed.ts",
    "pb:smoke": "POCKETBASE_URL=http://localhost:8090 PB_ADMIN_EMAIL=admin@emmaus.local PB_ADMIN_PASSWORD=devpassword tsx scripts/smoke-liturgy-repo-pb.ts",
    "pb:prod:tunnel": "kubectl --context eco port-forward -n emmaus svc/emmaus-pb 8091:80",
    "pb:prod:ui": "open https://db.emmaus.wien/_/",
    "render:smoke": "tsx scripts/smoke-render-job.ts"
  },
